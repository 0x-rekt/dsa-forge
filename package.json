{
  "name": "dsa-forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:prepare": "npm run db:migrate && npm run db:seed && npm run db:search-index && npm run db:embeddings",
    "db:search-index": "node --import tsx scripts/build-search-index.ts",
    "db:embeddings": "node --import tsx scripts/generate-embeddings.ts",
    "db:seed": "node --import tsx scripts/seed-dataset.ts",
    "progress:rebuild": "node --import tsx scripts/rebuild-progress.ts",
    "search:eval": "node --import tsx scripts/evaluate-search.ts",
    "db:studio": "prisma studio",
    "auth:generate": "auth generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/prisma-adapter": "latest",
    "@google/genai": "^2.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/sandbox": "^3.9.1",
    "better-auth": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "latest",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "pg": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "hyparquet": "^1.32.0",
    "prisma": "7.10.0",
    "tsx": "latest",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

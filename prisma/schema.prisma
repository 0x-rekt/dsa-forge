generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProblemDifficulty {
  Easy
  Medium
  Hard
}

enum ProblemChunkSection {
  statement
  approach
  complexity
  code
  editorial
}

enum AttemptVerdict {
  passed
  failed
  error
  timeout
  unverified
}

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  attempts      Attempt[]
  hintStates    HintState[]
  patternStats  UserPatternStat[]
  rateLimits    RateLimit[]
  queryLogs     QueryLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Problem {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  statement    String
  difficulty   ProblemDifficulty
  platform     String?
  sourceUrl    String?
  constraints  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  chunks       ProblemChunk[]
  patterns     ProblemPattern[]
  testCases    TestCase[]
  attempts     Attempt[]
  hintStates   HintState[]
  cacheEntries AnswerCache[]
  queryLogs    QueryLog[]

  @@index([difficulty])
  @@index([platform])
  @@map("problem")
}

model ProblemChunk {
  id        String                      @id @default(cuid())
  problemId String
  section   ProblemChunkSection
  content   String
  embedding Unsupported("vector(768)")?
  tsv       Unsupported("tsvector")?
  createdAt DateTime                    @default(now())
  problem   Problem                     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, section])
  @@map("problem_chunk")
}

model Pattern {
  id       String            @id @default(cuid())
  name     String            @unique
  problems ProblemPattern[]
  stats    UserPatternStat[]

  @@map("pattern")
}

model ProblemPattern {
  id        String  @id @default(cuid())
  problemId String
  patternId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([problemId, patternId])
  @@index([patternId])
  @@map("problem_pattern")
}

model TestCase {
  id             String  @id @default(cuid())
  problemId      String
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  sortOrder      Int     @default(0)
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, sortOrder])
  @@map("test_case")
}

model Attempt {
  id           String         @id @default(cuid())
  userId       String
  problemId    String
  language     String
  code         String
  verdict      AttemptVerdict
  hintsUsed    Int            @default(0)
  timeSpentSec Int?
  executionMs  Int?
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
  @@map("attempt")
}

model HintState {
  userId       String
  problemId    String
  currentLevel Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@map("hint_state")
}

model UserPatternStat {
  userId        String
  patternId     String
  attempts      Int      @default(0)
  passes        Int      @default(0)
  averageHints  Float    @default(0)
  weaknessScore Float    @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern       Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([userId, patternId])
  @@index([userId, weaknessScore])
  @@map("user_pattern_stat")
}

model AnswerCache {
  id        String   @id @default(cuid())
  problemId String
  hintLevel Int
  queryText String
  answer    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, hintLevel, queryText])
  @@index([problemId, hintLevel])
  @@index([expiresAt])
  @@map("answer_cache")
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String
  windowStart DateTime
  count       Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, windowStart])
  @@index([userId, windowStart])
  @@map("rate_limit")
}

model QueryLog {
  id          String   @id @default(cuid())
  userId      String?
  problemId   String?
  query       String
  cacheHit    Boolean  @default(false)
  retrievalMs Int?
  llmMs       Int?
  totalMs     Int?
  tokensIn    Int?
  tokensOut   Int?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  problem     Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("query_log")
}

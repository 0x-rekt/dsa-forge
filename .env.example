# Hosted Postgres needs TLS in production; append ?sslmode=require
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the deployment, e.g. https://dsa-forge.vercel.app
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: tutor, hint, and code-generation model.
GEMINI_TUTOR_MODEL=gemini-3.8-flash
# Optional: model used to rewrite vague queries for HyDE (hyde modes).
GEMINI_HYDE_MODEL=gemini-3.8-flash
# Optional: judge used by `npm run answers:eval`.
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# Optional: cosine-similarity threshold for reusing a near-duplicate cached
# tutor answer. Higher is stricter. Default 0.95.
ANSWER_CACHE_SIMILARITY=0.95

# Optional: cross-encoder reranking. Without this the API returns hybrid/RRF results.
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v3.5

# Optional: enables the cost estimate in `npm run logs:report`. USD per million
# tokens for the model in GEMINI_TUTOR_MODEL. Leave both unset to skip cost.
GEMINI_INPUT_PRICE_PER_MTOK=
GEMINI_OUTPUT_PRICE_PER_MTOK=

# Optional retrieval tuning. See README "Retrieval tuning".
SEARCH_KEYWORD_WEIGHT=0.2
SEARCH_VECTOR_WEIGHT=1
SEARCH_RERANK_WEIGHT=1
SEARCH_TITLE_BOOST=5